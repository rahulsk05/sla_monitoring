
# ==========================================
# Environment Variables / Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Backend - Python
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
/backend/venv/
/backend/.venv/
/backend/env/

# Testing and coverage
/backend/.pytest_cache/
/backend/.coverage
/backend/.coverage.*
/backend/htmlcov/
/backend/.tox/
/backend/.nox/

# Python packaging
/backend/build/
/backend/dist/
*.egg-info/

# Deployment artifacts
/backend/deployment/

# ==========================================
# Frontend - React / Vite / TypeScript
# ==========================================

# Dependencies
/frontend/node_modules/

# Build output
/frontend/dist/
/frontend/build/
/frontend/coverage/

# Vite cache
/frontend/.vite/

# TypeScript build information
/frontend/*.tsbuildinfo

# ESLint cache
/frontend/.eslintcache

# ==========================================
# Logs
# ==========================================
*.log
logs/

# ==========================================
# Temporary Files
# ==========================================
*.tmp
*.temp

# ==========================================
# IDE / Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
